# Used by `npm run dev` and the scripts. docker compose reads the same names.
DATABASE_URL=postgres://tesslet:tesslet@localhost:5432/tesslet
UPLOAD_DIR=./data/uploads
APP_NAME=Tesslet
# Comma-separated. These accounts get the /admin moderation queue when they sign up.
ADMIN_EMAILS=you@example.com
# Linked from the About page. No in-app payments, ever.
SUPPORT_URL=https://mkultra.monster/clearance/
# Public https URL of your deployment. Needed for Bluesky/ATProto login in production.
# Leave empty locally and open the app at http://127.0.0.1:3000 to test Bluesky login.
PUBLIC_URL=
